# Bling API v3 — credenciais (copie para .env e preencha)
#
# O token é renovado automaticamente e gravado de volta no .env.

# Host da API: api.bling.com.br (produção) ou www.bling.com.br
BLING_HOST=api.bling.com.br

BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REFRESH_TOKEN=

# Cache; preenchido/atualizado automaticamente no refresh
BLING_ACCESS_TOKEN=
BLING_EXPIRES_AT=0
